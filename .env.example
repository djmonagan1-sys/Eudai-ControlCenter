# Copy to .env.local for local development. In Vercel, set these as Environment Variables.
VITE_SUPABASE_URL=https://YOURPROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only (no VITE_ prefix — never exposed to the browser).
# OPTIONAL: leave unset to run in $0 mode; the copilot and AI meeting notes
# gracefully fall back to offline answers.
ANTHROPIC_API_KEY=sk-ant-...
